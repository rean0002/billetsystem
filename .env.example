# Kopiér til .env (som ikke kommer med i git) og vælg dit eget kodeord
DB_PASSWORD=SkrivEtKodeordHer

# Login på adminsiden via Clerk: "Publishable key" fra dashboard.clerk.com -> API keys
CLERK_PUBLISHABLE_KEY=pk_test_...
# Adresser, adminsiden bruges fra (kommasepareret), fx https://billetter.example.com
CLERK_AUTHORIZED_PARTIES=http://localhost:8081

# Afsender på bekræftelsesmails, og evt. en anden adresse kunderne kan svare til
MAIL_FROM=Eventforeningen <billetter@example.com>
MAIL_REPLY_TO=
