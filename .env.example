# Kopiér til .env (som ikke kommer med i git) og vælg dit eget kodeord
DB_PASSWORD=SkrivEtKodeordHer

# Den første admin oprettes automatisk ved opstart, hvis der ingen findes (mindst 10 tegn)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SkrivEtAdminKodeordHer

# Afsender på bekræftelsesmails, og evt. en anden adresse kunderne kan svare til
MAIL_FROM=Eventforeningen <billetter@example.com>
MAIL_REPLY_TO=
